<section class="intro">
  <div>
    <p class="eyebrow">PLC REMOTE</p>
    <h2>Gateway status and configuration</h2>
    <p>
      This page updates automatically. The WPA2 service WLAN stays on for local access;
      IPCBOX IN1 is shown for diagnostics and does not control it.
    </p>
  </div>
  <dl class="facts">
    <div>
      <dt>Service WLAN</dt><dd>{@service.ssid || "Off"}</dd>
    </div>
    <div>
      <dt>IN1</dt><dd>
        {case @service.gpio_asserted do
          true -> "Terminal high — observed only"
          false -> "Terminal low/open — observed only"
          :unknown -> "GPIO unknown — AP remains on"
        end}
      </dd>
    </div>
    <div>
      <dt>Internet sharing</dt><dd>{Phoenix.Naming.humanize(@service.routing)}</dd>
    </div>
  </dl>
</section>

<div class="status-overview" aria-label="Gateway status">
  <span class={["status", if(@network.connection == :internet, do: "ok", else: "pending")]}>Internet: {Phoenix.Naming.humanize(
    @network.connection
  )}</span>
  <span class={["status", if(@tailscale.lifecycle == :connected, do: "ok", else: "pending")]}>Tailscale: {Phoenix.Naming.humanize(
    @tailscale.lifecycle
  )}</span>
  <span class={["status", if(@service.active, do: "ok", else: "pending")]}>Service AP: {if @service.active,
    do: "On",
    else: "Off"}</span>
</div>

<.notice :if={@notice} class="success">{@notice}</.notice>
<.notice :if={@errors["settings"]} class="failure">{@errors["settings"]}</.notice>

<section class="configuration-panel" id="detected-devices">
  <div class="panel-heading">
    <div>
      <p class="eyebrow">LIVE DETECTION</p><h2>Detected network devices</h2>
    </div>
    <p>No Linux interface name is assumed. Roles are stored by stable hardware path.</p>
  </div>

  <.notice class={if elem(@suggestion, 0) == :ok, do: "success", else: "warning"}>
    {elem(@suggestion, 1)}
  </.notice>

  <div class="check-list">
    <div :for={interface <- @network.interfaces} class="check-row">
      <span class={["check-icon", if(interface.lower_up, do: "ok", else: "pending")]}>•</span>
      <div>
        <strong>{interface.ifname} — {Phoenix.Naming.humanize(interface.kind)}</strong>
        <p>{interface_label(interface)}</p>
        <small>MAC {interface.mac_address || "unknown"} · {interface.hw_path}</small>
      </div>
    </div>
  </div>
</section>

<section class="configuration-panel" id="network-settings">
  <div class="panel-heading">
    <div>
      <p class="eyebrow">INTERNET</p><h2>Select the Internet connection</h2>
    </div>
    <p>DHCP is tried by default. Choose static only when the plant network requires it.</p>
  </div>

  <.form for={%{}} as={:settings} id="network-form" phx-submit="save-network" autocomplete="off">
    <input type="hidden" name="settings[uplink_mode]" value="ethernet" />
    <div class="form-grid two">
      <label>
        Internet Ethernet controller
        <select name="settings[ethernet_interface_hw_path]">
          <option value="">Select a detected controller</option>
          <option
            :for={interface <- @ethernet}
            value={interface.hw_path}
            selected={
              selected?(
                suggested_uplink(@ethernet, @settings.uplink.ethernet.interface_hw_path),
                interface.hw_path
              )
            }
          >
            {interface_label(interface)}
          </option>
        </select>
        <.field_error errors={@errors} field="ethernet_interface_hw_path" />
      </label>
      <label>
        Address assignment
        <select name="settings[ethernet_method]">
          <option
            value="dhcp"
            selected={
              selected?(value(@draft, "ethernet_method", @settings.uplink.ethernet.method), :dhcp)
            }
          >
            DHCP — automatic
          </option>
          <option
            value="static"
            selected={
              selected?(
                value(@draft, "ethernet_method", @settings.uplink.ethernet.method),
                :static
              )
            }
          >
            Static — required by plant network
          </option>
        </select>
      </label>
      <label>Static address<input
        name="settings[ethernet_address]"
        value={value(@draft, "ethernet_address", @settings.uplink.ethernet.address)}
      /><.field_error errors={@errors} field="ethernet_address" /></label>
      <label>Prefix length<input
        type="number"
        min="1"
        max="30"
        name="settings[ethernet_prefix_length]"
        value={value(@draft, "ethernet_prefix_length", @settings.uplink.ethernet.prefix_length)}
      /></label>
      <label>Gateway<input
        name="settings[ethernet_gateway]"
        value={value(@draft, "ethernet_gateway", @settings.uplink.ethernet.gateway)}
      /></label>
      <label>DNS server<input
        name="settings[ethernet_name_server]"
        value={value(@draft, "ethernet_name_server", @settings.uplink.ethernet.name_server)}
      /></label>
    </div>
    <div class="panel-actions">
      <button class="primary" type="submit">Save Internet settings</button>
    </div>
  </.form>
</section>

<section class="configuration-panel" id="plc-settings">
  <div class="panel-heading">
    <div>
      <p class="eyebrow">PLC</p><h2>Configure the isolated PLC connection</h2>
    </div>
    <p :if={length(@ethernet) < 2}>
      A second Ethernet controller must be detected before the isolated PLC role can be enabled.
    </p>
  </div>

  <.form for={%{}} as={:settings} phx-submit="save-plc" autocomplete="off">
    <input type="hidden" name="settings[machine_enabled]" value="false" />
    <div class="toggle-line">
      <input
        id="machine-enabled"
        type="checkbox"
        name="settings[machine_enabled]"
        value="true"
        checked={checked?(@draft, "machine_enabled", @settings.machine.enabled)}
        disabled={length(@ethernet) < 2}
      />
      <label for="machine-enabled">Enable isolated PLC Ethernet</label>
    </div>
    <div class="form-grid two">
      <label>
        PLC Ethernet controller <% uplink =
          suggested_uplink(@ethernet, @settings.uplink.ethernet.interface_hw_path) %>
        <select name="settings[machine_interface_hw_path]" disabled={length(@ethernet) < 2}>
          <option value="">Select the separate PLC controller</option>
          <option
            :for={interface <- @ethernet}
            value={interface.hw_path}
            selected={
              selected?(
                suggested_machine(@ethernet, uplink, @settings.machine.interface_hw_path),
                interface.hw_path
              )
            }
          >
            {interface_label(interface)}
          </option>
        </select>
        <.field_error errors={@errors} field="machine_interface_hw_path" />
      </label>
      <label>Gateway address on PLC LAN<input
        name="settings[machine_address]"
        value={value(@draft, "machine_address", @settings.machine.address)}
      /></label>
      <label>PLC address<input
        name="settings[plc_address]"
        value={value(@draft, "plc_address", @settings.machine.plc_address)}
      /><.field_error errors={@errors} field="plc_address" /></label>
      <label>Prefix length<input
        type="number"
        min="1"
        max="30"
        name="settings[machine_prefix_length]"
        value={value(@draft, "machine_prefix_length", @settings.machine.prefix_length)}
      /></label>
    </div>
    <div class="panel-actions">
      <button class="primary" type="submit" disabled={length(@ethernet) < 2}>Save PLC settings</button>
    </div>
  </.form>
</section>

<section class="configuration-panel" id="tailscale-settings">
  <div class="panel-heading">
    <div>
      <p class="eyebrow">REMOTE ACCESS</p><h2>Join the Tailscale network</h2>
    </div>
    <p>
      The key is checked before anything is enabled or persisted. A failed attempt leaves this form ready for a new key.
    </p>
  </div>

  <.form for={%{}} as={:settings} phx-submit="enroll-tailscale" autocomplete="off">
    <div class="form-grid two">
      <label>
        One-use auth key
        <input
          name="settings[tailscale_auth_key]"
          type="password"
          placeholder="tskey-auth-…"
          autocomplete="off"
        />
        <.field_error errors={@errors} field="tailscale_auth_key" />
      </label>
      <label>Device name<input
        name="settings[tailscale_hostname]"
        value={@settings.tailscale.hostname}
      /></label>
    </div>
    <div class="connection-feedback">
      <.notice :if={@tailscale.lifecycle == :connected} class="success">
        <strong>Connected.</strong> Tailnet address: <code>{@tailscale.tailnet_ipv4}</code>
      </.notice>
      <.notice
        :if={@tailscale.lifecycle != :connected and @settings.tailscale.enabled}
        class="warning"
      >
        Stored identity is reconnecting: {Phoenix.Naming.humanize(@tailscale.lifecycle)}.
      </.notice>
    </div>
    <div class="panel-actions split">
      <button
        class="primary"
        type="submit"
        disabled={@enrolling}
        phx-disable-with="Testing key…"
      >{if @enrolling,
        do: "Testing key…",
        else: "Test key and connect"}</button>
      <button
        :if={@settings.tailscale.enabled}
        class="secondary"
        type="button"
        phx-click="disable-tailscale"
      >Disable Tailscale</button>
    </div>
  </.form>
</section>
